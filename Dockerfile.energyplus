# Optional image: backend + a real EnergyPlus install.
# Use it by pointing docker-compose's backend/worker `dockerfile:` here.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ENERGYPLUS_VERSION=23.2.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl ca-certificates libgl1 libglib2.0-0 libgomp1 libx11-6 \
 && curl -sSL -o /tmp/eplus.sh \
    "https://github.com/NREL/EnergyPlus/releases/download/v23.2.0/EnergyPlus-23.2.0-7636e6b3e9-Linux-Ubuntu22.04-x86_64.sh" \
 && chmod +x /tmp/eplus.sh && echo "y\n" | /tmp/eplus.sh || true \
 && ln -sf /usr/local/EnergyPlus-23-2-0/energyplus /usr/local/bin/energyplus || true \
 && rm -f /tmp/eplus.sh && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
RUN mkdir -p /data/uploads /opt/weather

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
